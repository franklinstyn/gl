import csv
import importlib
import json
from datetime import datetime
from decimal import Decimal
from pathlib import Path

import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq
from scrapy.exporters import CsvItemExporter, JsonItemExporter
from sqlalchemy import create_engine, select
from sqlalchemy.orm import sessionmaker

from avalon.items import (
    COLUMNS,
    FLOAT_COLUMNS,
    INTEGER_COLUMNS,
    LIST_COLUMNS,
    PRICE_COLUMNS,
)


BATCH_SIZE = 100


def load_model_config(spider, pipeline_type):
    module_name = spider.settings.get("MYSQL_MODEL_MODULE")

    if not module_name:
        raise ValueError("MYSQL_MODEL_MODULE is not configured")

    module = importlib.import_module(module_name)
    config = getattr(module, "PIPELINE_CONFIG", None)

    if not config:
        raise ValueError("PIPELINE_CONFIG is missing")

    if pipeline_type not in config:
        raise ValueError(
            "Pipeline configuration not found: " + pipeline_type
        )

    return module, config[pipeline_type]


def clean_value(value):
    if value is None or value == "":
        return None

    if isinstance(value, float) and value != value:
        return None

    return value


def to_int(value):
    value = clean_value(value)

    if value is None:
        return None

    return int(float(value))


def to_float(value):
    value = clean_value(value)

    if value is None:
        return None

    return float(value)


def to_decimal(value):
    value = clean_value(value)

    if value is None:
        return None

    return Decimal(str(value))


def prepare_row(item):
    row = {column: clean_value(item.get(column)) for column in COLUMNS}

    for column in ("community_id", "unit_id"):
        if row.get(column) is not None:
            row[column] = str(row[column])

    for column in INTEGER_COLUMNS:
        row[column] = to_int(row.get(column))

    for column in FLOAT_COLUMNS:
        row[column] = to_float(row.get(column))

    for column in PRICE_COLUMNS:
        row[column] = to_float(row.get(column))

    if not row.get("scraped_date"):
        timestamp = row.get("scrape_timestamp")

        if isinstance(timestamp, datetime):
            row["scraped_date"] = timestamp.strftime("%Y-%m-%d")
        elif timestamp:
            row["scraped_date"] = str(timestamp)[:10]

    for column in LIST_COLUMNS:
        value = row.get(column)

        if isinstance(value, str):
            try:
                value = json.loads(value)
            except json.JSONDecodeError:
                value = []

        row[column] = json.dumps(value or [], ensure_ascii=False)

    if isinstance(row.get("scrape_timestamp"), datetime):
        row["scrape_timestamp"] = row["scrape_timestamp"].strftime(
            "%Y-%m-%d %H:%M:%S"
        )

    if row.get("scraped_date"):
        row["scraped_date"] = str(row["scraped_date"])[:10]

    return row


def parquet_schema():
    fields = []

    for column in COLUMNS:
        if column in INTEGER_COLUMNS:
            column_type = pa.int64()
        elif column in FLOAT_COLUMNS or column in PRICE_COLUMNS:
            column_type = pa.float64()
        else:
            column_type = pa.string()

        fields.append(pa.field(column, column_type))

    return pa.schema(fields)


def model_columns(model):
    return {column.name for column in model.__table__.columns}


def create_model(model, row):
    columns = model_columns(model)
    values = {
        key: value
        for key, value in row.items()
        if key in columns
    }
    return model(**values)


def model_values(model):
    return {
        column.name: getattr(model, column.name)
        for column in model.__table__.columns
    }


def find_by_columns(session, model, values):
    filters = [
        getattr(model, column) == values.get(column)
        for column in values
    ]

    return session.execute(
        select(model).where(*filters)
    ).scalar_one_or_none()


def find_previous(session, model, row, logical_key):
    filters = [
        getattr(model, column) == row.get(column)
        for column in logical_key
    ]

    return session.execute(
        select(model)
        .where(*filters)
        .order_by(getattr(model, "scraped_date").desc())
        .limit(1)
    ).scalar_one_or_none()


def has_price_changed(previous, current, columns):
    for column in columns:
        if to_decimal(getattr(previous, column)) != to_decimal(
            current.get(column)
        ):
            return True

    return False


def create_history(history_model, previous):
    values = model_values(previous)
    columns = model_columns(history_model)

    values = {
        key: value
        for key, value in values.items()
        if key in columns
    }

    return history_model(**values)


def create_engine_and_session(spider):
    connection_string = spider.settings.get("MYSQL_CONNECTION")

    if not connection_string:
        raise ValueError("MYSQL_CONNECTION is not configured")

    engine = create_engine(connection_string)
    Session = sessionmaker(bind=engine)

    return engine, Session


class JsonPipeline:
    def open_spider(self, spider):
        self.output_dir = Path(
            spider.settings.get("EXPORT_DIR")
        )
        self.output_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        self.file = open(
            self.output_dir / "avalon_units.json",
            "wb",
        )

        self.exporter = JsonItemExporter(
            self.file,
            fields_to_export=COLUMNS,
            encoding="utf-8",
        )

        self.exporter.start_exporting()

    def process_item(self, item, spider):
        self.exporter.export_item(prepare_row(item))
        return item

    def close_spider(self, spider):
        self.exporter.finish_exporting()
        self.file.close()


