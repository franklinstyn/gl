class ParquetPipeline:
    def open_spider(self, spider):
        self.output_dir = Path(
            spider.settings.get("EXPORT_DIR")
        )
        self.output_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        self.rows = []
        self.writer = None
        self.schema = parquet_schema()

    def process_item(self, item, spider):
        self.rows.append(prepare_row(item))

        if len(self.rows) >= BATCH_SIZE:
            self.write_batch()

        return item

    def write_batch(self):
        if not self.rows:
            return

        if self.writer is None:
            self.writer = pq.ParquetWriter(
                str(self.output_dir / "avalon_units.parquet"),
                self.schema,
            )

        rows = [
            {
                column: (
                    str(value)
                    if value is not None
                    and self.schema.field(column).type == pa.string()
                    and not isinstance(value, str)
                    else value
                )
                for column, value in row.items()
            }
            for row in self.rows
        ]

        self.writer.write_table(
            pa.Table.from_pylist(
                rows,
                schema=self.schema,
            )
        )

        self.rows = []

    def close_spider(self, spider):
        try:
            self.write_batch()
        finally:
            if self.writer is not None:
                self.writer.close()


class MySQLFlatPipeline:
    def open_spider(self, spider):
        self.rows = []
        self.engine = None

        _, self.config = load_model_config(
            spider,
            "flat",
        )

        self.model = self.config["model"]
        self.history_model = self.config["history_model"]
        self.logical_key = self.config["logical_key"]
        self.daily_key = self.config["daily_key"]
        self.history_compare = self.config["history_compare"]

        self.engine, self.Session = create_engine_and_session(spider)
        self.model.metadata.create_all(self.engine)
        self.rows = []

    def process_item(self, item, spider):
        self.rows.append(prepare_row(item))

        if len(self.rows) >= BATCH_SIZE:
            self.write_batch()

        return item

    def write_batch(self):
        if not self.rows:
            return

        session = self.Session()

        try:
            for row in self.rows:
                existing = find_by_columns(
                    session,
                    self.model,
                    {
                        column: row.get(column)
                        for column in self.daily_key
                    },
                )

                if existing:
                    continue

                previous = find_previous(
                    session,
                    self.model,
                    row,
                    self.logical_key,
                )

                if previous and has_price_changed(
                    previous,
                    row,
                    self.history_compare,
                ):
                    session.add(
                        create_history(
                            self.history_model,
                            previous,
                        )
                    )

                session.add(
                    create_model(
                        self.model,
                        row,
                    )
                )

            session.commit()
            self.rows = []

        except Exception:
            session.rollback()
            self.rows = []
            raise

        finally:
            session.close()

    def close_spider(self, spider):
        try:
            if self.engine is not None:
                self.write_batch()
        finally:
            if self.engine is not None:
                self.engine.dispose()


class MySQLRelationalPipeline:
    def open_spider(self, spider):
        self.rows = {}
        self.engine = None

        _, self.config = load_model_config(
            spider,
            "relational",
        )

        self.models = self.config["models"]
        self.pricing_model = self.config["pricing_model"]
        self.pricing_history_model = self.config[
            "pricing_history_model"
        ]
        self.pricing_logical_key = self.config[
            "pricing_logical_key"
        ]
        self.pricing_daily_key = self.config[
            "pricing_daily_key"
        ]
        self.history_compare = self.config[
            "history_compare"
        ]

        self.engine, self.Session = create_engine_and_session(spider)
        self.models[0].metadata.create_all(self.engine)
        self.rows = {}

    def process_item(self, item, spider):
        row = prepare_row(item)

        key = tuple(
            row.get(column)
            for column in self.pricing_daily_key
        )

        self.rows[key] = row

        if len(self.rows) >= BATCH_SIZE:
            self.write_batch()

        return item

    def write_batch(self):
        if not self.rows:
            return

        session = self.Session()

        try:
            for row in self.rows.values():
                self.write_relational_row(
                    session,
                    row,
                )

            session.commit()
            self.rows = {}

        except Exception:
            session.rollback()
            self.rows = {}
            raise

        finally:
            session.close()

    def write_relational_row(self, session, row):
        for model in self.models:
            key_columns = getattr(
                model,
                "__pipeline_key__",
                None,
            )

            if not key_columns:
                continue

            existing = find_by_columns(
                session,
                model,
                {
                    column: row.get(column)
                    for column in key_columns
                },
            )

            if not existing:
                session.add(
                    create_model(
                        model,
                        row,
                    )
                )

        existing_pricing = find_by_columns(
            session,
            self.pricing_model,
            {
                column: row.get(column)
                for column in self.pricing_daily_key
            },
        )

        if existing_pricing:
            return

        previous = find_previous(
            session,
            self.pricing_model,
            row,
            self.pricing_logical_key,
        )

        if previous and has_price_changed(
            previous,
            row,
            self.history_compare,
        ):
            session.add(
                create_history(
                    self.pricing_history_model,
                    previous,
                )
            )

        session.add(
            create_model(
                self.pricing_model,
                row,
            )
        )

    def close_spider(self, spider):
        try:
            if self.engine is not None:
                self.write_batch()
        finally:
            if self.engine is not None:
                self.engine.dispose()


def read_input_file(path):
    path = Path(path)

    if path.suffix.lower() == ".json":
        with open(
            path,
            "r",
            encoding="utf-8",
        ) as file:
            return json.load(file)

    if path.suffix.lower() == ".csv":
        with open(
            path,
            "r",
            newline="",
            encoding="utf-8",
        ) as file:
            return list(csv.DictReader(file))

    if path.suffix.lower() == ".parquet":
        return pd.read_parquet(path).to_dict(
            orient="records"
        )

    raise ValueError(
        "Unsupported file format: " + path.suffix
    )


class FileToMySQLPipeline(MySQLRelationalPipeline):
    def open_spider(self, spider):
        MySQLRelationalPipeline.open_spider(
            self,
            spider,
        )

        self.output_dir = Path(
            spider.settings.get("EXPORT_DIR")
        )

        self.file_format = spider.settings.get(
            "MYSQL_FILE_FORMAT",
            "csv",
        )

    def process_item(self, item, spider):
        return item

    def close_spider(self, spider):
        if self.engine is None:
            return

        input_file = (
            self.output_dir
            / ("avalon_units." + self.file_format)
        )

        if not input_file.exists():
            spider.logger.warning(
                "File not found: %s",
                input_file,
            )
            self.engine.dispose()
            return

        rows = read_input_file(input_file)
        self.rows = {}

        for row in rows:
            row = prepare_row(row)

            key = tuple(
                row.get(column)
                for column in self.pricing_daily_key
            )

            self.rows[key] = row

            if len(self.rows) >= BATCH_SIZE:
                self.write_batch()

        try:
            self.write_batch()
        finally:
            self.engine.dispose()
