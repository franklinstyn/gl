"""
Google Maps restaurant spider (Selenium drives the browser, Scrapy runs the
crawl, settings and pipelines).

    scrapy crawl gmaps_restaurants
    scrapy crawl gmaps_restaurants -a limit=5 -a headless=0 -a reviews=5

Layout of this file
  1. helpers + PARSERS  - pure functions that read page HTML (no browser needed,
                          easy to test or fix from a saved debug page)
  2. SEL                - every XPath that Selenium clicks/waits on
  3. the spider         - search -> collect links -> per place: overview/hours,
                          reviews (newest first), about -> yield one dict
Google changes its markup often. If a field comes back empty, set
SAVE_DEBUG_HTML = True, run again, and adjust the matching parser/XPath.
"""
import random
import re
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote_plus

import scrapy
from parsel import Selector
from selenium import webdriver
from selenium.common.exceptions import TimeoutException, WebDriverException
from selenium.webdriver.common.by import By
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.support.ui import WebDriverWait

from gmaps.models import RestaurantFlat

PLACE_ID_RE = re.compile(r"!1s(0x[0-9a-fA-F]+:0x[0-9a-fA-F]+)")
PUA_RE = re.compile("[\ue000-\uf8ff]")  # icon-font glyphs Maps puts in text
DAYS = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
HOURS_COLUMNS = {day: day + "_timing" for day in DAYS}

# About columns come from the model: about_dining_options <- section "Dining options"
ABOUT_PREFIX = "about_"
OTHER_COLUMN = "about_other"
ABOUT_COLUMNS = {
    column.name[len(ABOUT_PREFIX):].replace("_", " "): column.name
    for column in RestaurantFlat.__table__.columns
    if column.name.startswith(ABOUT_PREFIX) and column.name != OTHER_COLUMN
}


# ============================================================================
# 1. Helpers and parsers
# ============================================================================
def clean(value):
    if value is None:
        return None
    value = PUA_RE.sub("", str(value))
    value = value.replace("\u202f", " ").replace("\u00a0", " ").replace("\u2009", " ")
    value = re.sub(r"\s+", " ", value).strip()
    return value or None


def to_number(text, integer=False):
    if not text:
        return None
    match = re.search(r"\d[\d,]*\.?\d*", text)
    if not match:
        return None
    number = match.group(0).replace(",", "")
    try:
        return int(float(number)) if integer else float(number)
    except ValueError:
        return None


def strip_label(label, prefix):
    label = clean(label)
    if label and label.lower().startswith(prefix.lower()):
        label = clean(label[len(prefix):])
    return label


def extract_place_id(url):
    match = PLACE_ID_RE.search(url or "")
    return match.group(1) if match else None


def with_english(url):
    if "hl=en" in url:
        return url
    return url + ("&" if "?" in url else "?") + "hl=en"


def parse_overview(sel):
    """Name, rating, review count, price range, address, phone, website, plus code."""
    name = clean(sel.xpath('string(//h1[contains(@class,"DUwDvf")])').get()) or clean(
        sel.xpath("string(//h1)").get()
    )

    rating = to_number(
        sel.xpath('//div[contains(@class,"F7nice")]//span[@aria-hidden="true"]/text()').get()
    )
    if rating is None:
        rating = to_number(
            sel.xpath('//span[@role="img"][contains(@aria-label,"stars")]/@aria-label').get()
        )

    review_count = to_number(
        sel.xpath(
            '//div[contains(@class,"F7nice")]//span[contains(@aria-label,"review")]/@aria-label'
        ).get(),
        integer=True,
    )

    price_range = strip_label(
        sel.xpath('//span[starts-with(@aria-label,"Price")]/@aria-label').get(), "Price:"
    )

    category = clean(sel.xpath('//button[contains(@jsaction,"category")]//text()').get())

    address = strip_label(
        sel.xpath('//button[@data-item-id="address"]/@aria-label').get(), "Address:"
    )

    phone = strip_label(
        sel.xpath('//button[starts-with(@data-item-id,"phone:tel:")]/@aria-label').get(), "Phone:"
    )
    if not phone:
        item_id = sel.xpath('//button[starts-with(@data-item-id,"phone:tel:")]/@data-item-id').get()
        phone = clean(item_id.split("phone:tel:", 1)[1]) if item_id else None

    website = clean(sel.xpath('//a[@data-item-id="authority"]/@href').get())

    plus_code = strip_label(
        sel.xpath('//button[@data-item-id="oloc"]/@aria-label').get(), "Plus code:"
    )

    return {
        "name": name,
        "category": category,
        "rating": rating,
        "review_count": review_count,
        "price_range": price_range,
        "address": address,
        "phone": phone,
        "website": website,
        "plus_code": plus_code,
    }


def parse_hours(sel):
    """Raw timing text per weekday: {'monday_timing': '11 am–11 pm', ...}."""
    hours = {column: None for column in HOURS_COLUMNS.values()}
    for row in sel.xpath("//table//tr[td]"):
        cells = row.xpath("./td")
        if len(cells) < 2:
            continue
        day = (clean(cells[0].xpath("string(.)").get()) or "").lower()
        if day not in HOURS_COLUMNS:
            continue
        parts = [clean(li.xpath("string(.)").get()) for li in cells[1].xpath(".//li")]
        parts = [p for p in parts if p]
        timing = ", ".join(parts) if parts else clean(cells[1].xpath("string(.)").get())
        hours[HOURS_COLUMNS[day]] = timing
    return hours


def parse_reviews(sel, limit):
    """First `limit` reviews in page order. The owner's reply is skipped."""
    reviews, seen = [], set()
    for card in sel.xpath('//div[@data-review-id][not(ancestor::div[@data-review-id])]'):
        review_id = card.attrib.get("data-review-id")
        if review_id in seen:
            continue
        seen.add(review_id)

        text = clean(
            " ".join(
                card.xpath(
                    './/span[contains(@class,"wiI7pd")]'
                    '[not(ancestor::div[contains(@class,"CDe7pd")])]//text()'
                ).getall()
            )
        )
        reviews.append(
            {
                "reviewer_name": clean(card.xpath('.//div[contains(@class,"d4r55")]/text()').get()),
                "rating": to_number(
                    card.xpath(
                        './/span[@role="img"][contains(@aria-label,"star")]/@aria-label'
                    ).get()
                ),
                "date": clean(card.xpath('.//span[contains(@class,"rsqaWe")]/text()').get()),
                "text": text,
            }
        )
        if len(reviews) >= limit:
            break
    return reviews


def parse_about(sel):
    """{'Accessibility': ['Wheelchair accessible entrance', ...], 'Crowd': [...]}."""
    scopes = sel.xpath('//div[@role="tabpanel"]') or [sel]
    sections = {}
    for scope in scopes:
        for heading in scope.xpath(".//h2[following-sibling::ul]"):
            title = clean(heading.xpath("string(.)").get())
            if not title:
                continue
            items = []
            for li in heading.xpath("./following-sibling::ul[1]/li"):
                text = clean(li.xpath("string(.)").get())
                if text:
                    items.append(text)
            if items:
                sections.setdefault(title, items)
    return sections


def split_about(sections):
    """Known sections -> their model columns (list), everything else -> other."""
    columns = {column: None for column in ABOUT_COLUMNS.values()}
    other = {}
    for title, items in sections.items():
        column = ABOUT_COLUMNS.get(title.lower())
        if column:
            columns[column] = items
        else:
            other[title] = items
    return columns, other


def build_item(scraped_at, query, rank, place_id, overview, hours, reviews, about_columns, about_other):
    """Every item has exactly the same keys, so CSV/Parquet headers stay stable."""
    item = {
        "scrape_timestamp": scraped_at,
        "search_query": query,
        "search_rank": rank,
        "place_id": place_id,
    }
    item.update(overview)
    item.update(hours)
    item["reviews"] = reviews
    item.update(about_columns)
    item[OTHER_COLUMN] = about_other or None
    return item


# ============================================================================
# 2. Selenium selectors
# ============================================================================
SEL = {
    "consent": '//button[contains(normalize-space(.),"Accept all") or contains(normalize-space(.),"Reject all")]',
    "feed": '//div[@role="feed"]',
    "heading": "//h1",
    "end_of_list": '//span[contains(text(),"reached the end")]',
    "hours_toggle": '//*[@aria-expanded="false"][contains(@aria-label,"open hours")]',
    "review_card": '//div[@data-review-id][not(ancestor::div[@data-review-id])]',
    "sort_button": '//button[contains(@aria-label,"Sort") or @data-value="Sort" or normalize-space(.)="Sort"]',
    "sort_newest": '//*[@role="menuitemradio"][contains(normalize-space(.),"Newest")]',
    "more_button": '//div[@data-review-id]//button[contains(@aria-label,"See more") or normalize-space(.)="More"]',
    "about_heading": '//div[@role="tabpanel"]//h2',
}


def tab_xpath(label):
    return '//button[@role="tab"][starts-with(@aria-label,"%s") or normalize-space(.)="%s"]' % (
        label, label,
    )


# ============================================================================
# 3. The spider
# ============================================================================
class GmapsRestaurantSpider(scrapy.Spider):
    name = "gmaps_restaurants"

    def __init__(self, query=None, limit=None, reviews=None, headless=None, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._args = {"query": query, "limit": limit, "reviews": reviews, "headless": headless}
        self.scraped_at = datetime.now(timezone.utc).isoformat()
        self.driver = None

    # -- startup -------------------------------------------------------------
    def load_options(self):
        settings, args = self.settings, self._args
        self.query = args["query"] or settings.get("SEARCH_QUERY", "restaurants in Lahore")
        self.limit = int(args["limit"] or settings.getint("RESTAURANT_LIMIT", 40))
        self.reviews_per_place = int(args["reviews"] or settings.getint("REVIEWS_PER_PLACE", 10))
        if args["headless"] is None:
            self.headless = settings.getbool("SELENIUM_HEADLESS", True)
        else:
            self.headless = str(args["headless"]).lower() in ("1", "true", "yes")
        self.keywords = [k.lower() for k in settings.getlist("RESTAURANT_CATEGORY_KEYWORDS")]
        self.action_delay = tuple(settings.getlist("ACTION_DELAY") or (0.8, 1.8))
        self.place_delay = tuple(settings.getlist("PLACE_DELAY") or (2.0, 5.0))
        self.save_debug_html = settings.getbool("SAVE_DEBUG_HTML", False)

        model_columns = {c.name for c in RestaurantFlat.__table__.columns}
        missing = [c for c in HOURS_COLUMNS.values() if c not in model_columns]
        if missing:
            raise ValueError("models.py is missing hours columns: %s" % missing)

    async def start(self):  # Scrapy >= 2.13
        for request in self.start_requests():
            yield request

    def start_requests(self):
        self.load_options()
        # Scrapy needs one request to start; the browser does the real work.
        yield scrapy.Request("data:,", callback=self.crawl, dont_filter=True)

    def closed(self, reason):
        self.close_driver()

    # -- main flow -----------------------------------------------------------
    def crawl(self, response):
        self.driver = self.make_driver()
        accepted = failures = 0
        try:
            self.open_search()
            links = self.collect_links(self.limit * 3)  # extra candidates for skipped places
            self.logger.info("Found %d candidate places for %r", len(links), self.query)

            for rank, url in enumerate(links, start=1):
                if accepted >= self.limit:
                    break
                try:
                    item = self.scrape_place(url, rank)
                    failures = 0
                except Exception as exc:  # one bad place must not stop the run
                    failures += 1
                    self.logger.error("Place #%d failed (%s): %r", rank, url[:90], exc)
                    if failures >= 5:
                        self.logger.error("5 failures in a row, stopping (blocked or browser crashed?)")
                        break
                    continue

                if item is None:
                    continue
                accepted += 1
                self.logger.info("[%d/%d] %s", accepted, self.limit, item["name"])
                yield item
                self.pause(*self.place_delay)
        finally:
            self.close_driver()

    # -- browser -------------------------------------------------------------
    def make_driver(self):
        options = webdriver.ChromeOptions()
        if self.headless:
            options.add_argument("--headless=new")
        options.add_argument("--window-size=1400,1000")
        options.add_argument("--lang=en-US")
        options.add_experimental_option("prefs", {"intl.accept_languages": "en-US,en"})
        return webdriver.Chrome(options=options)  # Selenium Manager fetches the driver

    def close_driver(self):
        if self.driver is not None:
            try:
                self.driver.quit()
            except WebDriverException:
                pass
            self.driver = None

    def pause(self, low=None, high=None):
        low, high = (low, high) if low is not None else self.action_delay
        time.sleep(random.uniform(low, high))

    def js_click(self, element):
        self.driver.execute_script("arguments[0].click();", element)

    def wait_for(self, xpath, seconds=15):
        return WebDriverWait(self.driver, seconds).until(
            EC.presence_of_element_located((By.XPATH, xpath))
        )

    def dump(self, rank, step):
        if not self.save_debug_html:
            return
        folder = Path(self.settings.get("DEBUG_DIR", "debug"))
        folder.mkdir(parents=True, exist_ok=True)
        (folder / ("%02d_%s.html" % (rank, step))).write_text(
            self.driver.page_source, encoding="utf-8"
        )

    # -- search --------------------------------------------------------------
    def open_search(self):
        self.driver.get("https://www.google.com/maps/search/%s?hl=en" % quote_plus(self.query))
        try:  # cookie consent (shown in some regions)
            self.js_click(self.wait_for(SEL["consent"], 4))
            self.pause()
        except TimeoutException:
            pass
        self.wait_for(SEL["feed"], 20)

    def collect_links(self, wanted):
        """Scroll the results list and collect place URLs in the order Maps shows them.
        Sponsored results do not link to /maps/place/, so they are skipped."""
        links, seen, idle = [], set(), 0
        while len(links) < wanted and idle < 4:
            feed = self.driver.find_element(By.XPATH, SEL["feed"])
            hrefs = self.driver.execute_script(
                "return Array.from(arguments[0].querySelectorAll('a[href*=\"/maps/place/\"]'))"
                ".map(a => a.href);",
                feed,
            )
            grew = False
            for href in hrefs:
                key = extract_place_id(href) or href
                if key not in seen:
                    seen.add(key)
                    links.append(href)
                    grew = True
            if self.driver.find_elements(By.XPATH, SEL["end_of_list"]):
                break
            idle = 0 if grew else idle + 1
            self.driver.execute_script("arguments[0].scrollTop = arguments[0].scrollHeight;", feed)
            self.pause(1.0, 2.0)
        return links


    def scrape_place(self, url, rank):
        driver = self.driver
        driver.get(with_english(url))
        self.wait_for(SEL["heading"], 20)
        self.pause()

        self.expand_hours()
        page = Selector(text=driver.page_source)
        self.dump(rank, "overview")

        overview = parse_overview(page)
        overview["maps_url"] = driver.current_url
        place_id = extract_place_id(driver.current_url) or extract_place_id(url)
        if not overview["name"] or not place_id:
            self.logger.error("Place #%d: no name/id found, skipped (%s)", rank, url[:90])
            return None
        if not self.is_restaurant(overview["category"]):
            self.logger.info("Skipping non-restaurant: %s (%s)", overview["name"], overview["category"])
            return None

        hours = parse_hours(page)
        reviews = self.collect_reviews(rank)
        about_columns, about_other = split_about(self.collect_about(rank))

        return build_item(
            self.scraped_at, self.query, rank, place_id,
            overview, hours, reviews, about_columns, about_other,
        )

    def is_restaurant(self, category):
        if not self.keywords or not category:
            return True
        category = category.lower()
        return any(word in category for word in self.keywords)

    def expand_hours(self):
        try:
            self.js_click(self.driver.find_element(By.XPATH, SEL["hours_toggle"]))
            self.pause(0.5, 1.0)
        except WebDriverException:
            pass  # already expanded, or the place has no hours

    def click_tab(self, label):
        try:
            self.js_click(self.wait_for(tab_xpath(label), 10))
            self.pause()
            return True
        except TimeoutException:
            self.logger.warning("Tab %r not found", label)
            return False

    def collect_reviews(self, rank):
        driver = self.driver
        if not self.click_tab("Reviews"):
            return []
        try:
            self.wait_for(SEL["review_card"], 15)
        except TimeoutException:
            return []

        self.sort_newest()

        previous = -1
        for _ in range(12):
            cards = driver.find_elements(By.XPATH, SEL["review_card"])
            if len(cards) >= self.reviews_per_place or len(cards) == previous:
                break
            previous = len(cards)
            driver.execute_script(
                "let el = arguments[0];"
                "while (el && el.scrollHeight <= el.clientHeight + 5) { el = el.parentElement; }"
                "if (el) { el.scrollTop = el.scrollHeight; }",
                cards[-1],
            )
            self.pause(0.8, 1.5)

        for button in driver.find_elements(By.XPATH, SEL["more_button"]):  # full review text
            try:
                self.js_click(button)
            except WebDriverException:
                pass
        self.pause(0.5, 1.0)

        self.dump(rank, "reviews")
        return parse_reviews(Selector(text=driver.page_source), self.reviews_per_place)

    def sort_newest(self):
        try:
            self.js_click(self.wait_for(SEL["sort_button"], 8))
            self.pause()
            self.js_click(self.wait_for(SEL["sort_newest"], 8))
            self.pause(1.5, 2.5)
        except TimeoutException:
            self.logger.warning("Could not switch reviews to 'Newest' (kept Maps' default order)")

    def collect_about(self, rank):
        if not self.click_tab("About"):
            return {}
        try:
            self.wait_for(SEL["about_heading"], 10)
        except TimeoutException:
            return {}
        self.dump(rank, "about")
        return parse_about(Selector(text=self.driver.page_source))
